rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null
        && request.auth.uid == 'SUBSTITUA_PELO_UID_DO_ADMINISTRADOR';
    }

    match /{document=**} {
      allow read, write: if isAdministrator();
    }
  }
}
