rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.currentStock == 0
        && request.resource.data.active == true;

      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.currentStock >= 0;

      allow delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && movementId == request.resource.data.idempotencyKey
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.quantityInBaseUnit > 0
        && request.resource.data.resultingStock >= 0
        && request.resource.data.type in ['entry', 'exit'];

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
